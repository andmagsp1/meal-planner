{
  "name": "meal-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "npx @biomejs/biome lint .",
    "lint:fix": "npx @biomejs/biome lint --write .",
    "preview": "vite preview",
    "test": "npx vitest",
    "test:ui": "npx vitest --ui",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "format": "npx @biomejs/biome format --write .",
    "format:check": "npx @biomejs/biome format .",
    "check": "npx @biomejs/biome check .",
    "check:fix": "npx @biomejs/biome check --write ."
  },
  "dependencies": {
    "@sb1/ffe-buttons": "^100.4.1",
    "@sb1/ffe-buttons-react": "^100.4.1",
    "@sb1/ffe-core": "^100.4.1",
    "@sb1/ffe-icons": "^100.4.1",
    "@sb1/ffe-icons-react": "^100.4.1",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.145.11",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "json-server": "^1.0.0-beta.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@eslint/js": "^9.36.0",
